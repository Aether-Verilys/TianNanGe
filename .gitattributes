# Normalize text while keeping Unity assets and their .meta files reviewable.
* text=auto
*.cs text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.controller text eol=lf
*.inputactions text eol=lf

# Model sources and HDR lighting images are stored in Git LFS.
*.fbx filter=lfs diff=lfs merge=lfs -text
*.FBX filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text

# Keep ordinary reference images, textures, and previews in Git.
*.png binary
*.jpg binary
*.jpeg binary
